# Keep the build context small and, more importantly, keep secrets and local
# state out of it entirely — anything listed here cannot reach a layer.

.git
.github
node_modules
.next
out
infra/node_modules
infra/cdk.out

# ⛔ Never in an image.
.env
.env.*
!.env.example
*.pem
*.key
supabase/

# Local and editor state
.vscode
.idea
.DS_Store
*.log
coverage
.turbo
tsconfig.tsbuildinfo

# Not needed at runtime or for migrations
docs
# ⚠ …except one data file: tests/unit/debate/resolution-block-data.test.ts
# imports this snapshot, and the build type-checks the tests. Excluding it fails
# the image build with a missing-module error that looks nothing like its cause.
!docs/data/staging-markets-snapshot.json
# ⚠ tests/ STAYS IN THE BUILD CONTEXT. `next build` type-checks the whole
# project, and scripts/lots-1-staging-wipe.ts imports from tests/staging — so
# excluding it fails the build at type-check, not at runtime. The build stage is
# discarded; the runner image carries none of this.
*.md
!README.md
.claude
claude-progress.md
